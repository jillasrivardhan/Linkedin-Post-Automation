    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "jillasrivardhan@gmail.com",
        "subject": "=✅ Approve LinkedIn Post — Day {{ $(\"Compute Day & Topic\").item.json.dayNumber }}: {{ $(\"Compute Day & Topic\").item.json.topic }}",
        "message": "=<h2>Day {{ $(\"Compute Day & Topic\").item.json.dayNumber }} of 30 — {{ $(\"Compute Day & Topic\").item.json.topic }}</h2>\n<p>Here is today's AI-generated LinkedIn post. Please review and approve or decline:</p>\n<hr/>\n<pre style=\"white-space:pre-wrap;font-family:sans-serif;font-size:14px;\">{{ $json.message.content }}</pre>\n<hr/>\n<p>Click <strong>Approve</strong> to publish immediately to LinkedIn, or <strong>Decline</strong> to skip today's post.</p>",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Approve & Post"
          }
        },

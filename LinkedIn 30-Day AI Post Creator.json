              "triggerAtHour": 3,
              "triggerAtMinute": 30
            }
          ]
        }
      },
      "id": "39622a7b-7634-45f1-91fb-7865f0b77060",
      "name": "Daily 9 AM IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const topics = [\n  'AI Agents',\n  'RAG',\n  'Embeddings',\n  'Vector Databases',\n  'Prompt Engineering',\n  'LLM Context Windows',\n  'AI Hallucinations',\n  'Function Calling',\n  'Tool Calling',\n  'AI Agent Memory',\n  'Multi-Agent Systems',\n  'AI Evaluation',\n  'Fine-Tuning',\n  'LoRA',\n  'AI APIs',\n  'AI Automation',\n  'n8n AI Agents',\n  'Webhooks + AI',\n  'AI Workflows',\n  'Computer Vision',\n  'Multimodal AI',\n  'AI Security',\n  'Prompt Injection',\n  'RAG Security',\n  'AI Cost Optimization',\n  'LLM Latency',\n  'Open-Source LLMs',\n  'AI Coding Assistants',\n  'AI in Software Development',\n  'The Future of Agentic AI'\n];\n\n// Campaign starts on 2026-09-03 (Day 1)\nconst startDate = new Date('2026-09-03T00:00:00.000Z');\nconst today = new Date();\ntoday.setUTCHours(0, 0, 0, 0);\n\nconst diffMs = today.getTime() - startDate.getTime();\nconst dayNumber = Math.floor(diffMs / (24 * 60 * 60 * 1000)) + 1;\n\n// Outside the 30-day window — stop the workflow\nif (dayNumber < 1 || dayNumber > 30) {\n  return [];\n}\n\nconst topic = topics[dayNumber - 1];\nreturn [{ json: { dayNumber, topic } }];"
      },
      "id": "b225c93b-cfcb-420b-abbd-b7fe589fac11",
      "name": "Compute Day & Topic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "resource": "chat",
        "chatModel": "gpt-4o-mini",
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": "You are an expert LinkedIn content creator specialising in AI topics. Write engaging posts that educate professionals, spark curiosity, and drive real engagement. Each post must:\n- Be 150-300 words\n- Open with a compelling hook (bold statement, surprising fact, or rhetorical question)\n- Provide concise, practical insights with real-world context\n- Use short paragraphs for mobile readability\n- End with a thought-provoking question to invite comments\n- Include 3-5 relevant hashtags on a final line\n- Maintain a professional yet conversational tone"
            },
            {
              "content": "=Write a LinkedIn post about \"{{ $json.topic }}\" — this is Day {{ $json.dayNumber }} of a 30 Days of AI series. Make it informative, engaging, and valuable for AI professionals and enthusiasts."
            }
          ]
        },
        "options": {},
        "requestOptions": {}
      },
      "id": "9e34f2b4-670f-4645-be0b-3b3243517f46",
      "name": "Generate LinkedIn Post",
      "type": "n8n-nodes-base.openAi",
